# Copy to .env (which is gitignored) and fill in. Used by `bash scripts/deploy_profile.sh`, which writes
# these values into the Minecraft profile's config/minecraftai.json ("llm" section). The game does not read .env.
# MINECRAFTAI_LLM_* (below) is the current name to use. The old public DEEPSEEK_API_KEY is accepted
# as an API-key fallback before the interim AIBOT_LLM_API_KEY / AIBOT_LLM_BASE_URL /
# AIBOT_LLM_MODEL names; current MINECRAFTAI_LLM_* values always win.
# API key for the LLM provider. Never commit the real one.
MINECRAFTAI_LLM_API_KEY=
# OpenAI-compatible base URL, or Google's Gemini base: https://generativelanguage.googleapis.com/v1beta/openai
MINECRAFTAI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MINECRAFTAI_LLM_MODEL=gemini-3.5-flash-lite
