# Force LF everywhere, regardless of platform or local core.autocrlf. Several tests read
# source files as raw text and assert on exact multi-line substrings; CRLF breaks them.
* text=auto eol=lf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.ttf binary
*.otf binary

# Vendored upstream Baritone: keep every byte exactly as upstream committed it (no EOL/text normalization).
third_party/baritone/** -text
# The patch series must stay byte-exact too (context lines are matched literally by git apply).
tools/baritone/patches/*.patch -text whitespace=-blank-at-eol
