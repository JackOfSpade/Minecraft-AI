+    /**
+     * Both orthogonal corners are valid feet positions while a diagonal settles. Refuse the
+     * move during search when either corner is outside the host's immutable cell authority, so
+     * a bounded route can choose a factual cardinal leg instead of being rejected after it has
+     * already won the A* race.
+     */
+    private static boolean navigationDiagonalFootprintAllowed(CalculationContext context,
+                                                               int x, int y, int z, int destX, int destZ) {
+        return context.bsi.isNavigationCellAllowed(x, y, z)
+                && context.bsi.isNavigationCellAllowed(x, y, destZ)
+                && context.bsi.isNavigationCellAllowed(destX, y, z)
+                && context.bsi.isNavigationCellAllowed(destX, y, destZ);
+    }
