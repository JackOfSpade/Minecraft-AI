@@ -121,6 +121,17 @@ public interface IPlayerContext {
         return BaritoneAPI.getSettings().allowPlace.value;
     }
 
+    /**
+     * Whether the process named {@code process} ({@code "mine"}, {@code "get_to_block"}, {@code "farm"}, {@code "explore"},
+     * {@code "build"}) may be started for this player. Those processes pick their targets by scanning every loaded chunk for
+     * blocks, i.e. they know where things are without the player having seen them; a host whose players must only act on what
+     * they can observe refuses them here, and the process does nothing (a refused start leaves the process inactive). The
+     * default allows everything, which is what upstream does.
+     */
+    default boolean allowScanningProcess(String process) {
+        return true;
+    }
