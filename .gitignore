.gradle/
/.gradle-user-home/
build/
run/
out/
classes/

.DS_Store
Thumbs.db
desktop.ini

# Secrets and local environment overrides. API keys belong in env vars, never in the repo.
.env
.env.*
*.env
# The committed template (no secrets) must stay visible despite the patterns above.
!.env.example
secrets.properties
secrets.*.properties
local.properties
*.pem
*.p12
*.jks
*.keystore

# JVM crash dumps and editor backup/swap files.
hs_err_pid*.log
replay_pid*.log
*.log
*.bak
*.orig
*~
*.swp

.idea/
*.iml
*.ipr
*.iws
.vscode/
.eclipse/
*.launch
.settings/
.project
.classpath
bin/

# Keep legacy planning and work logs local while tracking project docs.
# !README.md exists to keep Minecraft-Spawn-Bots-Wrapper/README.md tracked (no README.md/.zh-CN.md
# exists at the repo root; !README.zh-CN.md was dropped as dead since no such file exists anywhere).
*.md
!README.md
!docs/
!docs/*.md
!docs/**/*.md
# The vendored Baritone provenance note (BaritoneVendorIntegrityTest reads it); *.md would otherwise hide it.
!third_party/baritone/UPSTREAM.md

# Local reference source used during implementation.
references/

# headless production test server (installer-generated, includes a 56MB server.jar)
run-prod/

# Local promotional workspaces and generated dependency trees.
/minecraftai-tiktok-promo/
/promo/tiktok/
node_modules/

# Runtime logs and disposable server snapshots.
/logs/
/tmp/

# Ad-hoc reliability run output stays local. Keep the repository's existing
# runner state file tracked for backward compatibility.
/reports/reliability_*.tsv
!/reports/reliability_state.tsv
/reports/full_validation/
/reports/*.txt

# Immutable harness output is local until a VERIFIED run is explicitly pinned.
artifacts/evidence/
artifacts/evidence-batches/
artifacts/mining-shards/

# Transient files used while atomically pinning committed baseline evidence.
# Override broad repository-level ignores such as build/, run/, bin/, and *.md
# so a safe capability id cannot silently make explicitly pinned evidence local.
!reports/baselines/
!reports/baselines/**
reports/baselines/.pin.lock/
reports/baselines/.pin.lock.stale.*
reports/baselines/.staging.*
reports/baselines/.index.*

# GameTest harness outputs (C:\mcw\_tools\gt_filter.sh)
gt_results*.txt
gt_logs/
# worktree debris of GameTest / evidence runs (run output is never committed)
gt_*.out
gt_all_run.txt
round*.out
run*.out
sweep.out
